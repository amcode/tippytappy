<plist version="1.0">
<dict>
    <!-- Hardened runtime is required for notarisation. The app needs no exceptions:
         it uses NSEvent monitors (Input Monitoring TCC permission, not an entitlement)
         and CoreAudio device properties, neither of which need the microphone entitlement
         because no audio is captured. -->
</dict>
</plist>
